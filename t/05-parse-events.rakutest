#!raku

use Test;
use lib $?FILE.IO.parent.add('lib');
use Terminal::MultiProgress;
use TestParse;
use TestOut;

plan 6;

# a log with timestamps: durations come from the log, not the clock,
# and noise lines are ignored
my $log = q:to/LOG/;
2026-08-13T19:00:00Z alpha start
-- worker pool resized to 4 --
2026-08-13T19:00:01Z bravo start
2026-08-13T19:00:05Z bravo finish
this line is not an event
2026-08-13T19:00:07Z alpha finish
2026-08-13T19:00:12Z charlie start
2026-08-13T19:00:30Z charlie finish
LOG

my $events = supply { .emit for $log.lines.map(&parse-line).grep(*.defined) }
my $out = capture-run {
  Terminal::MultiProgress.new(title => 'jobs', tick => 30, :show-summary).run: $events;
}

ok $out.defined, 'run() exits once the log is consumed';
like $out, /'alpha' .* 'finished in 00:00:07'/, 'alpha shows its logged duration';
like $out, /'bravo' .* 'finished in 00:00:04'/, 'bravo shows its logged duration';
like $out, /'charlie' .* 'finished in 00:00:18'/, 'charlie shows its logged duration';
like $out, /'completed: 3' \s+ 'running: 0'/, 'summary line: all jobs completed';
unlike $out, /'worker pool'/, 'noise lines draw nothing';

done-testing;
